{
  // Команды, которые агент может запускать без карточки подтверждения.
  // Совпадение по префиксу: "git" покрывает "git status", "git diff" и т.д.
  // "cmd:args*" — база и glob аргументов (см. docs: permissions.json).
  // Allowlist выполняется сразу и не проходит классификатор Auto-review,
  // поэтому сюда не входят sudo, rm, dd и прочие разрушительные команды.
  "terminalAllowlist": [
    // Оболочка и обзор файлов
    "ls",
    "eza",
    "exa",
    "lsd",
    "tree",
    "cat",
    "bat",
    "head",
    "tail",
    "less",
    "more",
    "wc",
    "file",
    "stat",
    "pwd",
    "echo",
    "printf",
    "which",
    "whereis",
    "type",
    "command",
    "basename",
    "dirname",
    "realpath",
    "readlink",
    "date",
    "uname",
    "id",
    "whoami",
    "env",
    "printenv",
    "true",
    "false",
    "test",
    "sleep",
    "seq",
    "tee",
    "cut",
    "sort",
    "uniq",
    "tr",
    "column",
    "nl",
    "od",
    "hexdump",
    "xxd",
    "strings",
    "diff",
    "cmp",
    "comm",
    "paste",
    "fold",
    "du",
    "df",
    "free",
    "uptime",
    "nproc",
    "getconf",
    "ps",
    "pgrep",
    "top",
    "htop",
    "btop",
    "lsof",
    "ss",
    "watch",
    "timeout",
    "time",

    // Поиск
    "grep",
    "egrep",
    "fgrep",
    "rg",
    "ag",
    "ack",
    "find",
    "fd",
    "locate",

    // Правка и раскладка файлов внутри проекта
    "mkdir",
    "cp",
    "mv",
    "touch",
    "ln",
    "install",
    "chmod",
    "sed",
    "awk",
    "patch",
    "rsync",
    "truncate",

    // Архивы
    "tar",
    "gzip",
    "gunzip",
    "bzip2",
    "xz",
    "zstd",
    "zip",
    "unzip",

    // Сеть для документации, зависимостей и проверок
    "curl",
    "wget",
    "ping",
    "dig",
    "nslookup",
    "host",
    "jq",
    "yq",

    // Git и GitHub
    "git",
    "gh",
    "delta",
    "tig",

    // Go и этот репозиторий
    "go",
    "gofmt",
    "gofumpt",
    "goimports",
    "golangci-lint",
    "staticcheck",
    "gopls",
    "govulncheck",
    "gotestsum",
    "benchstat",
    "dlv",
    "make",
    "brig",
    "./bin/brig",
    "./bin/check-examples",

    // Скрипты и соседние тулчейны, которые нормально встретить в сессии
    "bash",
    "sh",
    "dash",
    "python",
    "python3",
    "pip",
    "pip3",
    "uv",
    "node",
    "npm",
    "npx",
    "pnpm",
    "yarn",
    "bun",
    "cargo",
    "rustc",
    "rustfmt",
    "gcc",
    "clang",
    "pkg-config",
    "cmake",
    "ninja",
    "just",
    "docker",
    "podman",
    "mise",
    "asdf",

    // Отладка рантайма, без правки системы
    "strace",
    "perf",
    "gdb",
    "lldb",
    "kill",
    "pkill"
  ],

  // Классификатор Auto-review: shell, MCP и Fetch, которые не попали в allowlist.
  // Инструкции — подсказка, не жёсткий запрет.
  "autoRun": {
    "allow_instructions": [
      "Auto-approve creating, editing, renaming, and applying patches to any file inside this project workspace, including Go sources, tests, docs, examples, Makefile, grammar, and .cursor config.",
      "Auto-approve read-only inspection of the workspace: listing, searching, reading files, git status, git diff, and git log.",
      "Auto-approve ordinary development commands for this Go repo: go test, go build, go fmt, go vet, golangci-lint, make, gh, and running ./bin/brig.",
      "Auto-approve package installs and network fetches that only download dependencies, modules, or documentation.",
      "Auto-approve debuggers and tracers (dlv, strace, perf, gdb) when they attach to a process started from this workspace."
    ],
    "block_instructions": [
      "Ask for approval before sudo, doas, su, or any command that needs root.",
      "Ask for approval before deleting files or directories, including rm, shred, and git clean.",
      "Ask for approval before writing, moving, or deleting anything outside this workspace.",
      "Ask for approval before git push --force, git reset --hard, or rewriting published history.",
      "Ask for approval before piping a downloaded script into a shell, or before changing SSH, shell rc, credentials, or .env files."
    ]
  }
}
