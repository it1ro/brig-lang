## Семантические версии (semver.org, без build-метаданных) и
## ограничения вида `^1.2`, `~1.2.3`, `>=1.0.0`, `=1.0.0`, `*`.
##
## ```brig repl
## > satisfies?(v("1.4.2"), c("^1.2"))
## true
## > satisfies?(v("2.0.0"), c("^1.2"))
## false
## > max_satisfying([v("1.0.0"), v("1.3.0"), v("2.0.0")], c("~1.3"))
## Some(Version{ major: 1, minor: 3, patch: 0, pre: [] })
## ```
module Semver

## Версия. `pre` — идентификаторы pre-release: `1.0.0-rc.1` →
## `["rc", 1]`; числовые — `Int`, остальные — `Str`.
type Version { major: Int, minor: Int, patch: Int, pre: List<Any> }

## Ограничение на версию.
type Constraint {
    Exact(Version),
    Caret(Version),
    Tilde(Version),
    AtLeast(Version),
    Any,
}

## Ошибка разбора: что не так и исходная строка.
type ParseError { reason: Atom, input: Str }

## Разбирает версию `MAJOR.MINOR.PATCH[-PRE]`.
##
## ```brig repl
## > parse("1.2.3")
## Ok(Version{ major: 1, minor: 2, patch: 3, pre: [] })
## > parse("1.2.3-rc.1")
## Ok(Version{ major: 1, minor: 2, patch: 3, pre: ["rc", 1] })
## > parse("1.x")
## Error(ParseError{ reason: :bad_number, input: "1.x" })
## ```
pub fn parse(s) ->
    (core, pre) = split_pre(Str.trim(s))
    match Str.split(core, ".")
        [a, b, c] -> build(s, [a, b, c], pre)
        [a, b] -> build(s, [a, b, "0"], pre)
        [a] -> build(s, [a, "0", "0"], pre)
        _ -> Error(ParseError{ reason: :bad_shape, input: s })

fn split_pre(s) ->
    match Str.find(s, "-")
        Some(i) -> (Str.slice(s, 0, i), Str.slice(s, i + 1, len(s)))
        None -> (s, "")

fn build(input, parts, pre) ->
    nums = map(parts, p -> Str.to_int(p))
    match nums
        [Some(ma), Some(mi), Some(pa)] ->
            Ok(Version{ major: ma, minor: mi, patch: pa, pre: pre_ids(pre) })
        _ -> Error(ParseError{ reason: :bad_number, input: input })

fn pre_ids("") -> []
fn pre_ids(pre) -> map(Str.split(pre, "."), id -> pre_id(id, Str.to_int(id)))

fn pre_id(_id, Some(n)) -> n
fn pre_id(id, None) -> id

## Как `parse`, но бросает `(:bad_version, s)`; для литералов в коде.
pub fn v(s) ->
    match parse(s)
        Ok(ver) -> ver
        Error(_) -> raise((:bad_version, s))

## Разбирает ограничение.
##
## ```brig repl
## > constraint("^1.2")
## Ok(Caret(Version{ major: 1, minor: 2, patch: 0, pre: [] }))
## > constraint("*")
## Ok(Any)
## ```
pub fn constraint("*") -> Ok(Any)
pub fn constraint("^" <> rest) -> Result.map(parse(rest), Caret)
pub fn constraint("~" <> rest) -> Result.map(parse(rest), Tilde)
pub fn constraint(">=" <> rest) -> Result.map(parse(rest), AtLeast)
pub fn constraint("=" <> rest) -> Result.map(parse(rest), Exact)
pub fn constraint(s) -> Result.map(parse(s), Exact)

## Как `constraint`, но бросает.
pub fn c(s) ->
    match constraint(s)
        Ok(x) -> x
        Error(_) -> raise((:bad_constraint, s))

## Порядок версий по semver: `-1`, `0`, `1`.
##
## ```brig repl
## > compare(v("1.0.0-rc.1"), v("1.0.0"))
## -1
## > compare(v("1.10.0"), v("1.9.9"))
## 1
## ```
pub fn compare(a, b) ->
    cmp_all([
        cmp(a.major, b.major),
        cmp(a.minor, b.minor),
        cmp(a.patch, b.patch),
        cmp_pre(a.pre, b.pre),
    ])

fn cmp(x, y) when x < y -> -1
fn cmp(x, y) when x > y -> 1
fn cmp(_, _) -> 0

fn cmp_all([]) -> 0
fn cmp_all([0, ..rest]) -> cmp_all(rest)
fn cmp_all([d, ..]) -> d

# Версия без pre-release старше версии с ним.
fn cmp_pre([], []) -> 0
fn cmp_pre([], _) -> 1
fn cmp_pre(_, []) -> -1
fn cmp_pre(a, b) -> cmp(a, b)

## Удовлетворяет ли версия ограничению.
pub fn satisfies?(_ver, Any) -> true
pub fn satisfies?(ver, Exact(x)) -> compare(ver, x) == 0
pub fn satisfies?(ver, AtLeast(x)) -> compare(ver, x) >= 0
pub fn satisfies?(ver, Caret(x)) ->
    compare(ver, x) >= 0 and compare(ver, caret_upper(x)) < 0
pub fn satisfies?(ver, Tilde(x)) ->
    compare(ver, x) >= 0 and compare(ver, Version{ ..x, minor: x.minor + 1, patch: 0, pre: [] }) < 0

fn caret_upper(Version{ major: 0, minor: 0, patch: p }) -> Version{ major: 0, minor: 0, patch: p + 1, pre: [] }
fn caret_upper(Version{ major: 0, minor: m }) -> Version{ major: 0, minor: m + 1, patch: 0, pre: [] }
fn caret_upper(x) -> Version{ major: x.major + 1, minor: 0, patch: 0, pre: [] }

## Наибольшая версия из списка, удовлетворяющая ограничению.
pub fn max_satisfying(versions, con) ->
    ok = filter(versions, ver -> satisfies?(ver, con))
    fold(ok, None, pick_max)

fn pick_max(None, ver) -> Some(ver)
fn pick_max(Some(best), ver) -> if compare(ver, best) > 0 then Some(ver) else Some(best)

## Следующая версия.
##
## ```brig repl
## > to_string(bump(v("1.2.3"), :minor))
## "1.3.0"
## ```
pub fn bump(ver, :major) -> Version{ major: ver.major + 1, minor: 0, patch: 0, pre: [] }
pub fn bump(ver, :minor) -> { ..ver, minor: ver.minor + 1, patch: 0, pre: [] }
pub fn bump(ver, :patch) -> { ..ver, patch: ver.patch + 1, pre: [] }

## Строковая форма.
pub fn to_string(Version{ major: a, minor: b, patch: c, pre: [] }) -> "\(a).\(b).\(c)"
pub fn to_string(ver) ->
    ids = Str.join(map(ver.pre, to_str), ".")
    "\(ver.major).\(ver.minor).\(ver.patch)-\(ids)"
