# Юнит-тесты домена: чистые функции, без приложения и без акторов.
# needs: T-133, T-135, T-137, T-143, T-147, horizon
#   brig test с обнаружением модулей (05) — T-147; опровержимый паттерн в `=` (03/L21) — T-133;
#   pub fn — T-143; модули проекта — T-135, T-137;
#   horizon: Changeset (06).
#   Доступ к полям (03/L4) уже работает.
module Test.MonitorsTest

import Test
import Lookout.Monitors.Monitor

pub fn tests() ->
    Test.describe("Monitor.changeset")

    Test.it("проставляет дефолты", fn ->
        Ok(m) = Monitor.changeset(%{ "name" => "a", "url" => "https://a.test" })
        Test.assert_eq(m.interval_ms, 30_000)
        Test.assert_eq(m.status, :unknown))

    Test.it("отклоняет слишком частый интервал", fn ->
        res = Monitor.changeset(%{ "name" => "a", "url" => "https://a.test", "interval_ms" => 100 })
        match res
            Error((:invalid, cs)) -> Test.assert(Changeset.has_error(cs, :interval_ms))
            Ok(_)                 -> Test.fail("expected :invalid"))
