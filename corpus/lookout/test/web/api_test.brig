# Интеграционные тесты API без сокетов и без sleep:
# Calmar.Test гоняет pipeline в памяти (Conn -> Conn — чистая функция),
# время фейковое, БД — :memory:, внешние HTTP-запросы чекеров подменены.
#
# needs: T-133, T-147, T-176, horizon
#   brig test с обнаружением модулей test/ (05) — T-147; Json.at (03/L16) — T-176;
#   опровержимый паттерн в `=` (03/L21) — T-133;
#   horizon: Calmar.Test (06), фейковые часы + in-memory транспорт (02/R9), подмена Http.Client (Q-mock).
module Test.Web.ApiTest

import Test
alias Calmar.Test as HT

fn auth() -> [("authorization", "Bearer test")]

pub fn tests() ->
    Test.describe("POST /api/monitors")

    Test.it("создаёт монитор и сразу запускает чекер", fn ->
        app = HT.start(Lookout.Application, { env: :test })
        HT.stub_http(app, "https://example.org", { status: 200 })

        resp = HT.post(app, "/api/monitors", {
            headers: auth(),
            json: %{ "name" => "example", "url" => "https://example.org" },
        })
        Test.assert_eq(resp.status, 201)
        Some(id) = Json.at(resp.json, ["data", "id"])   # m["k"] даёт Option (§4.5) — см. 03/L16

        HT.advance_time(app, 1)                  # первый :tick через 0 мс
        show = HT.get(app, "/api/monitors", { headers: auth() })
        Test.assert_eq(Json.at(show.json, ["data", 0, "status"]), Some("up")))

    Test.it("422 на невалидный URL", fn ->
        app = HT.start(Lookout.Application, { env: :test })
        resp = HT.post(app, "/api/monitors", {
            headers: auth(),
            json: %{ "name" => "x", "url" => "ftp://nope" },
        })
        Test.assert_eq(resp.status, 422)
        Test.assert_eq(Json.at(resp.json, ["errors", "url"]), Some(["only http(s)"])))

    Test.it("401 без токена", fn ->
        app = HT.start(Lookout.Application, { env: :test })
        Test.assert_eq(HT.get(app, "/api/monitors", {}).status, 401))

    Test.describe("SSE /api/monitors/{id}/events")

    Test.it("шлёт событие при смене статуса", fn ->
        app = HT.start(Lookout.Application, { env: :test })
        HT.stub_http(app, "https://flaky.test", { status: 200 })
        { json: json } = HT.post(app, "/api/monitors", {
            headers: auth(),
            json: %{ "name" => "flaky", "url" => "https://flaky.test", "interval_ms" => 5_000 },
        })
        Some(id) = Json.at(json, ["data", "id"])
        stream = HT.open_stream(app, "/api/monitors/\(id)/events", { headers: auth() })

        HT.advance_time(app, 1)
        HT.stub_http(app, "https://flaky.test", { status: 503 })
        HT.advance_time(app, 5_000)

        ev = HT.next_event(stream)
        Test.assert_eq(ev.event, "status")
        Test.assert_eq(Json.at(ev.data, ["status"]), Some("down")))
