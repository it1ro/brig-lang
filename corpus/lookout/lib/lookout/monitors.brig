# Контекст «Мониторы» — публичный API домена. Контроллеры, скрипты и тесты
# ходят только сюда, не в Repo напрямую.
# needs: T-135, T-137, T-145, T-146, horizon
#   многострочные строки (03/L9) — T-145;
#   Result.map (04) — T-146;
#   модули проекта — T-135, T-137;
#   horizon: Repo/Sql, PubSub (04).
#   Доступ к полям (03/L4) уже работает; Time.now (02/R7) в файле не используется.
module Lookout.Monitors

import Lookout.Repo
import Lookout.Monitors.Monitor
alias Lookout.Monitors.Supervisor as Sup
import Calmar.PubSub

pub fn list() ->
    Repo.all(Monitor, "select * from monitors order by name", [])

# Ok(Monitor{..}) | Error((:not_found, (:monitor, id)))
pub fn get(id) ->
    Repo.one(Monitor, "select * from monitors where id = ?", [id])

pub fn create(params) ->
    with
        Ok(m)     <- Monitor.changeset(params)
        Ok(saved) <- Repo.insert("monitors", m)
        Ok(_)     <- Sup.start_checker(saved)
        PubSub.broadcast(:pubsub, "monitors", (:monitor_created, saved))
        Ok(saved)

pub fn recent_checks(monitor_id, limit) ->
    Repo.rows(
        """
        select status, took_ms, checked_at
        from checks
        where monitor_id = ?
        order by checked_at desc
        limit ?
        """,
        [monitor_id, limit])

# Вызывается чекером. Одна транзакция: запись проверки + статус монитора.
pub fn record_check(event) ->
    Repo.transaction(fn (tx) ->
        with
            Ok(_) <- Repo.exec(tx, "insert into checks (monitor_id, status, took_ms, checked_at) values (?, ?, ?, ?)",
                    [event.monitor_id, to_str(event.status), event.took_ms, event.at])
            Ok(_) <- Repo.exec(tx, "update monitors set status = ?, last_checked_at = ? where id = ?",
                    [to_str(event.status), event.at, event.monitor_id])
            Ok(event))

# Уведомить подписчиков, только если статус реально изменился.
pub fn publish_change(old_status, event) when old_status == event.status -> :unchanged
pub fn publish_change(_, event) ->
    PubSub.broadcast(:pubsub, "monitor:\(event.monitor_id)", (:status_changed, event))
    PubSub.broadcast(:pubsub, "monitors", (:status_changed, event))
    :published
