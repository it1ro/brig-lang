## Выбор версий зависимостей: brig main.brig
module Main

import Semver

fn available() ->
    %{
        "json" => ["1.0.0", "1.2.0", "1.2.5", "2.0.0-rc.1", "2.0.0"],
        "http" => ["0.3.0", "0.3.4", "0.4.0"],
        "log" => ["1.0.0"],
    }

fn wanted() -> [("json", "^1.2"), ("http", "^0.3"), ("log", ">=2.0"), ("csv", "*"), ("xml", "~bad")]

fn resolve((name, spec)) ->
    with
        Ok(con) <- Semver.constraint(spec)
        Some(raw) <- Map.get(available(), name)
        Ok(vers) <- Result.all(map(raw, Semver.parse))
        Some(best) <- Semver.max_satisfying(vers, con)
        Ok((name, best))
    else
        Error(Semver.ParseError{ reason: r, input: i }) -> Error((name, :bad_spec, r, i))
        None -> Error((name, :no_match, spec))

fn describe(Ok((name, Semver.Version{ major: 0 } as v))) -> "\(name) \(Semver.to_string(v)) (unstable)"
fn describe(Ok((name, v))) -> "\(name) \(Semver.to_string(v))"
fn describe(Error(e)) -> "error: \(e)"

fn main() ->
    results = map(wanted(), resolve)
    _ = map(results, r -> print(describe(r)))
    next = Semver.bump(Semver.ver("1.2.3"), :major)
    print("bump:", Semver.to_string(next), next == Semver.Version{ major: 2, minor: 0, patch: 0, pre: [] })
    print(Semver.satisfies?(next, Semver.Caret(Semver.ver("2.0.0"))), Semver.compare(next, Semver.ver("2.0.0-rc.1")))
