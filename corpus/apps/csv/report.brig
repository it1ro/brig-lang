## Сводка продаж из CSV: `region,product,qty,price`.
##
## Конвейер: текст → строки (`Csv.parse`) → записи (`Csv.with_header`)
## → типизированные `Sale` (`to_sale`) → группировка по региону →
## итоги. Любая ошибка останавливает конвейер и возвращается как
## `Error((stage, detail))`.
module Report

import Csv

type Sale { region: Str, product: Str, qty: Int, price: Float }

type Total { region: Str, orders: Int, units: Int, revenue: Float }

## Полный конвейер от текста до итогов по регионам (по убыванию выручки).
pub fn build(text) ->
    with
        Ok(rows) <- tag(:csv, Csv.parse(text))
        Ok(recs) <- tag(:header, Csv.with_header(rows))
        Ok(sales) <- tag(:row, Result.all(Enum.map(recs, to_sale)))
        Ok(sort_desc(totals(sales)))
    else
        Error(e) -> Error(e)

fn tag(stage, Ok(v)) -> Ok(v)
fn tag(stage, Error(e)) -> Error((stage, e))

## Запись CSV → `Sale`. Числа проверяются.
##
## ```brig repl
## > to_sale(%{"region" => "eu", "product" => "x", "qty" => "2", "price" => "1.5"})
## Ok(Sale{ region: "eu", product: "x", qty: 2, price: 1.5 })
## > to_sale(%{"region" => "eu", "product" => "x", "qty" => "two", "price" => "1.5"})
## Error((:qty, "two"))
## ```
pub fn to_sale(rec) ->
    with
        Some(region) <- Map.get(rec, "region")
        Some(product) <- Map.get(rec, "product")
        Ok(qty) <- int_field(rec, "qty")
        Ok(price) <- float_field(rec, "price")
        Ok(Sale{ region: region, product: product, qty: qty, price: price })
    else
        None -> Error(:missing_column)
        Error(e) -> Error(e)

fn int_field(rec, name) ->
    raw = Map.get_or(rec, name, "")
    match Str.to_int(Str.trim(raw))
        Some(n) -> Ok(n)
        None -> Error((to_atom(name), raw))

fn float_field(rec, name) ->
    raw = Map.get_or(rec, name, "")
    match Str.to_float(Str.trim(raw))
        Some(f) -> Ok(f)
        None -> Error((to_atom(name), raw))

# Нет Str → Atom: имена колонок — фиксированный набор.
fn to_atom("qty") -> :qty
fn to_atom("price") -> :price
fn to_atom(_) -> :field

## Итоги по регионам.
pub fn totals(sales) ->
    groups = Enum.fold(sales, %{}, (acc, s) -> Map.update(acc, s.region, [], xs -> [s, ..xs]))
    Enum.map(Map.keys(groups), r -> total(r, Map.get_or(groups, r, [])))

fn total(region, sales) ->
    Total{
        region: region,
        orders: len(sales),
        units: Enum.fold(sales, 0, (a, s) -> a + s.qty),
        revenue: Enum.fold(sales, 0.0, (a, s) -> a + s.qty * s.price),
    }

fn sort_desc(ts) ->
    keyed = Enum.map(ts, t -> (0.0 - t.revenue, t.region, t))
    Enum.map(Enum.sort(keyed), fn ((_, _, t)) -> t)

## Таблица для печати.
pub fn render(ts) ->
    lines = Enum.map(ts, t -> "\(Str.pad_right(t.region, 8, " ")) \(Str.pad_right(to_str(t.orders), 6, " ")) \(Str.pad_right(to_str(t.units), 6, " ")) \(Float.to_str(t.revenue, 2))")
    Str.join(["region   orders units  revenue", ..lines], "\n")
