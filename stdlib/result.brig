## Функции над `Result` (§10.1): `Ok(v)` или `Error(e)`. Субъект — первый
## аргумент (T-120): `File.read(path) |> Result.map(parse)`. Не `Result`
## на месте субъекта — `(:type_error, (:<имя>, r))`.
module Result

## `Ok(f(v))` для `Ok(v)`, `Error(e)` — как есть.
##
## ```brig repl
## > Result.map(Ok(2), x -> x * 10)
## Ok(20)
## > Error(:boom) |> Result.map(x -> x * 10)
## Error(:boom)
## ```
pub fn map(Ok(v), f) -> Ok(f(v))
pub fn map(Error(e), _) -> Error(e)
pub fn map(r, _) -> raise((:type_error, (:map, r)))

## `f(v)` для `Ok(v)` — `f` сама возвращает `Result`; `Error(e)` — как
## есть.
##
## ```brig repl
## > Result.and_then(Ok(4), x -> if x > 0 then Ok(x - 1) else Error(:zero))
## Ok(3)
## > Result.and_then(Ok(0), x -> if x > 0 then Ok(x - 1) else Error(:zero))
## Error(:zero)
## > Result.and_then(Error(:boom), x -> Ok(x))
## Error(:boom)
## ```
pub fn and_then(Ok(v), f) -> f(v)
pub fn and_then(Error(e), _) -> Error(e)
pub fn and_then(r, _) -> raise((:type_error, (:and_then, r)))

## Значение из `Ok(v)`. `Error(e)` — `raise((:unwrap, Error(e)))`.
##
## ```brig repl
## > Result.unwrap(Ok(1))
## 1
## > Result.unwrap(Error(:enoent))
## raise (:unwrap, Error(:enoent))
## ```
pub fn unwrap(Ok(v)) -> v
pub fn unwrap(Error(e)) -> raise((:unwrap, Error(e)))
pub fn unwrap(r) -> raise((:type_error, (:unwrap, r)))

## Значение из `Ok(v)`, для `Error(_)` — `default`.
##
## ```brig repl
## > Result.unwrap_or(Ok(1), 0)
## 1
## > Error(:timeout) |> Result.unwrap_or(0)
## 0
## ```
pub fn unwrap_or(Ok(v), _) -> v
pub fn unwrap_or(Error(_), default) -> default
pub fn unwrap_or(r, _) -> raise((:type_error, (:unwrap_or, r)))

## Список `Result` → `Result` списка: `Ok` со всеми значениями по порядку
## или первый `Error`. Пустой список — `Ok([])`. Не `List` —
## `(:type_error, (:all, rs))`, элемент не `Result` —
## `(:type_error, (:all, r))`.
##
## ```brig repl
## > Result.all([Ok(1), Ok(2)])
## Ok([1, 2])
## > [Ok(1), Error(:bad), Error(:worse)] |> Result.all()
## Error(:bad)
## > Result.all([])
## Ok([])
## ```
pub fn all(rs) ->
    match rs
        [..] -> collect(rs)
        _ -> raise((:type_error, (:all, rs)))

# collect — первый не-Ok решает: Error — результат, прочее — :type_error.
fn collect(rs) ->
    match Enum.find(rs, r -> not ok?(r))
        None -> Ok(Enum.map(rs, unwrap))
        Some(Error(e)) -> Error(e)
        Some(r) -> raise((:type_error, (:all, r)))

fn ok?(Ok(_)) -> true
fn ok?(_) -> false
