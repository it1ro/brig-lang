# Плаг — функция Conn -> Conn. Если плаг задал ответ (conn.resp = Some),
# раннер дальше не идёт — отдельного halt нет.
# NEEDS: pub fn (03/L3), Conn (06), Crypto.secure_compare (04), Config.get (04)
module LookoutWeb.Plugs

import Calmar.Conn

pub fn require_token(conn) -> check_token(conn, Conn.bearer(conn))

fn check_token(conn, Some(token)) ->
    match Config.get(:api_token)
        Some(expected) ->
            if Crypto.secure_compare(token, expected) then conn else deny(conn)
        None -> deny(conn)
fn check_token(conn, None) -> deny(conn)

fn deny(conn) ->
    conn |> Conn.json(401, %{ "error" => "unauthorized" })
