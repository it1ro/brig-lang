{# Лэйаут задаётся в пайплайне :browser (Plug.put_layout(Layouts.app), 15);
   inner — уже отрендеренный Html.Safe действия; csrf_token и flash кладут плаги.
   NEEDS: шаблоны .bt (15) #}
{params inner: Html.Safe, title: Option<Str>, csrf_token: Str, flash: List<Str>}

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content={csrf_token}>
  <title>{Option.unwrap_or(title, "Мониторы")} · Lookout</title>
  <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
  <p :for={msg <- flash} class="flash">{msg}</p>
  <main>{inner}</main>
</body>
</html>
