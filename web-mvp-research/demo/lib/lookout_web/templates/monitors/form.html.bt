<%# Форма с ошибками changeset'а и CSRF-токеном (плаг Csrf.protect кладёт его в assigns).
    NEEDS: компилируемые шаблоны (03/L10), Form-хелперы (06) %>
<form method="post" action={Router.path(MonitorController.create)}>
  <input type="hidden" name="_csrf" value={assigns.csrf_token}>

  <label>Имя
    <input name="monitor[name]" value={Form.value(assigns.changeset, :name)}>
  </label>
  <small :for={e <- Form.errors(assigns.changeset, :name)} class="error">{e}</small>

  <label>URL
    <input name="monitor[url]" value={Form.value(assigns.changeset, :url)}>
  </label>
  <small :for={e <- Form.errors(assigns.changeset, :url)} class="error">{e}</small>

  <label>Интервал, мс
    <input name="monitor[interval_ms]" type="number" value={Form.value(assigns.changeset, :interval_ms)}>
  </label>

  <button>Сохранить</button>
</form>
