{# Компилируется `brig` в LookoutWeb.Templates.Monitors.index({ monitors: … }).
   Вставки {expr} экранируются по контексту; :for / :if / :else — атрибуты.
   NEEDS: шаблоны .bt (15), Router.path по функции (03/L5) #}
{params monitors: List<Monitor>}
{import LookoutWeb.Components}

<section>
  <header>
    <h1>Мониторы</h1>
    <a class="button" href={Router.path(MonitorController.new)}>Добавить</a>
  </header>

  <p :if={monitors == []}>Пока пусто. Добавьте первый URL.</p>
  <table :else>
    <thead><tr><th>Имя</th><th>URL</th><th>Статус</th><th>Проверен</th></tr></thead>
    <tbody>
      <tr :for={m <- monitors} id={"monitor-\(m.id)"}>
        <td><a href={Router.path(MonitorController.show, m)}>{m.name}</a></td>
        <td><code>{m.url}</code></td>
        <td><StatusBadge status={m.status} /></td>
        <td>{Time.ago(m.last_checked_at)}</td>
      </tr>
    </tbody>
  </table>
</section>
